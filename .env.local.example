# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA versione o .env.local (ele está no .gitignore).

# --- Supabase (autenticação + Postgres) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# --- Oracle / WinThor (integração somente-leitura) ---
DB_HOST=host-do-oracle
DB_PORT=1521
DB_SERVICE=nome-do-service
DB_USER=usuario-de-leitura
DB_PASSWORD=senha
